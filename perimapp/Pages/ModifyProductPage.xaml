<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Pages.ModifyProductPage"
             xmlns:localModels="clr-namespace:perimapp.Models"
             xmlns:localConverters="clr-namespace:perimapp.Converters"  
             xmlns:headers="clr-namespace:perimapp.Headers" 
             xmlns:pages="clr-namespace:perimapp.Pages"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             BackgroundColor="White">

    <ContentPage.Resources>
        <localConverters:DlcColorConverter x:Key="dlcColorConverter"/>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *, Auto">
            <headers:SharedHeader Grid.Row="0" HeaderText="Modifier"
                                  ProductUniqueId="{Binding ProductUniqueId, 
                                  Source={RelativeSource 
                                  AncestorType={x:Type pages:DetailsPage}}}">
            </headers:SharedHeader>

            <ScrollView Grid.Row="1" 
                        Padding="10" 
                        HorizontalOptions="FillAndExpand"   
                        VerticalOptions="FillAndExpand">
                 <VerticalStackLayout Spacing="10"
                                      HorizontalOptions="FillAndExpand">
                     <Border WidthRequest="150"
                            HeightRequest="150"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="0,20,0,10"
                            Padding="0"                
                            Background="Transparent"   
                            StrokeShape="{RoundRectangle CornerRadius='3'}"  
                            Stroke="Transparent"       
                            StrokeThickness="0">
                               <Image Source="{Binding CurrentProduct.UrlImage}" 
                                      Aspect="AspectFill"     
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"/>
                     </Border>

                     <Entry x:Name="ProductNameEntry"
                            Text="{Binding CurrentProduct.Name}" FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" Margin="0,0,0,10"
                            Placeholder="Nom du produit"/> 

                     <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                         <Label Text="DLC: "
                                FontSize="15"
                                TextColor="Gray"
                                VerticalOptions="Center"/>
        
                         <Border x:Name="ProductDlcEntry"
                                 BackgroundColor="Transparent"
                                 Padding="8,4"
                                 StrokeShape="{RoundRectangle CornerRadius=12}"
                                 HorizontalOptions="Center">
                             <DatePicker x:Name="DlcPicker"
                                         Date="{Binding CurrentProduct.Dlc, Mode=TwoWay}"
                                         Format="dd/MM/yyyy"
                                         MinimumDate="{x:Static sys:DateTime.Today}"
                                         TextColor="Black"
                                         HorizontalOptions="Center"
                                         />
                         </Border>
                     </HorizontalStackLayout>

                     <Grid ColumnDefinitions="Auto, Auto, Auto"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ColumnSpacing="8">
                            
                           <Border Grid.Column="0"
                                   WidthRequest="50"
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}"
                                   BackgroundColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                  
                                   <Button Text="-"
                                           FontSize="25"
                                           TextColor="Black"
                                           BackgroundColor="Transparent"
                                           CornerRadius="0"
                                           Padding="0"
                                           VerticalOptions="FillAndExpand"
                                           HorizontalOptions="FillAndExpand"
                                           Clicked="OnDecrementQuantityClicked"/>
                           </Border>
                            
                           <Border Grid.Column="1"
                                   WidthRequest="60" 
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}" 
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                   <Entry x:Name="QuantityEntry"
                                          Text="{Binding CurrentProduct.Quantity}"  
                                          FontSize="25"
                                          TextColor="Black"
                                          VerticalTextAlignment="Center"
                                          HorizontalTextAlignment="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="White"
                                          Keyboard="Numeric"
                                          ClearButtonVisibility="Never"
                                          MaxLength="2"/>
                           </Border>

                           <Border Grid.Column="2"
                                   WidthRequest="50"
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}"
                                   BackgroundColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                   <Button Text="+"
                                           FontSize="25"
                                           TextColor="Black"
                                           BackgroundColor="Transparent"
                                           CornerRadius="0"
                                           Padding="0"
                                           VerticalOptions="FillAndExpand"
                                           HorizontalOptions="FillAndExpand"
                                           Clicked="OnIncrementQuantityClicked" />
                           </Border>
                     </Grid>
                    
                    <Frame BackgroundColor="LightGray"
                           Padding="15"
                           Margin="0,10,0,10"
                           CornerRadius="0"
                           BorderColor="Transparent"
                           HasShadow="False"
                           HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding CurrentProduct.Category, StringFormat='Catégories : {0}'}"
                               FontSize="15"
                               TextColor="Black"
                               HorizontalOptions="FillAndExpand"   
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="4"/>    
                    </Frame>

                    <ContentView VerticalOptions="FillAndExpand" /> 
                 </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2"
                  HeightRequest="65"
                  BackgroundColor="#58BF7F"
                  HorizontalOptions="FillAndExpand"
                  VerticalOptions="End">
                  <Button Text="Enregistrer"
                          BackgroundColor="White"
                          TextColor="Black"
                          FontAttributes="Bold"
                          CornerRadius="30"
                          FontSize="20"
                          Padding="0,5"
                          Margin="0,10"
                          WidthRequest="300"
                          HorizontalOptions="FillAndExpand"
                          VerticalOptions="Center"
                          Clicked="OnSaveButtonClicked"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>