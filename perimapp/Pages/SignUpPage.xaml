<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Pages.SignUpPage"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="20" VerticalOptions="FillAndExpand">
        <Grid BackgroundColor="#58BF7F" Padding="20,20,20,20" VerticalOptions="StartAndExpand">
                <Label Text="Perim'App"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

            <Label Text="Inscription"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20"/>

                <Grid>
                    <Button Text="Avez-vous un code foyer ?"
                            Command="{Binding GotoHomeCodeCommand}"
                            TextColor="Gray"
                            BackgroundColor="Transparent"
                            HeightRequest="50"
                            FontSize="17"
                            HorizontalOptions="Center"
                            x:Name="CodeFoyerButton" />
                </Grid>

        <VerticalStackLayout Padding="20" Spacing="25" VerticalOptions="CenterAndExpand">
            <Grid>
                    <Entry Placeholder="Email"
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="50"
                           FontSize="20"
                           Text="{Binding EmailText, Mode=TwoWay}"
                           x:Name="EmailEntry"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="Black"
                             VerticalOptions="End"/>
                </Grid>

                <Grid>
                    <Entry Placeholder="Mot de passe"
                           IsPassword="True"
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="50"
                           FontSize="20"
                           Text="{Binding PasswordText, Mode=TwoWay}"
                           x:Name="PasswordEntry"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="Black"
                             VerticalOptions="End"/>
                </Grid>

                <Grid>
                    <Entry Placeholder="Confirmer mot de passe"
                           IsPassword="True"
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="50"
                           FontSize="20"
                           Text="{Binding ConfirmPasswordText, Mode=TwoWay}"
                           x:Name="ConfirmPasswordEntry"/>
                    <BoxView HeightRequest="1"
                             BackgroundColor="Black"
                             VerticalOptions="End"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="20,20,20,20" Spacing="15" VerticalOptions="EndAndExpand">
                <Button Text="Suivant"
                        Command="{Binding NextSignUpCommand}"
                        BackgroundColor="#58BF7F"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="50"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        WidthRequest="250"/>

                <Button Text="Retour"
                        Command="{Binding BackSignUpCommand}"
                        BackgroundColor="Black"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="50"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        WidthRequest="250"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
</ContentPage>
