<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Pages.MainPage"
             xmlns:localModels="clr-namespace:perimapp.Models"          
             xmlns:localConverters="clr-namespace:perimapp.Converters"  
             BackgroundColor="#FFF"
             Title="Mes Produits">

    <ContentPage.Resources>
        <localConverters:DlcColorConverter x:Key="dlcColorConverter" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, Auto, *">
            
            <!-- Header -->
            <Grid Grid.Row="0" BackgroundColor="#58BF7F" HeightRequest="65" Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Profil -->
                <Button Grid.Column="0"
                        Clicked="OnProfileIconClicked"
                        BackgroundColor="LightGray"
                        WidthRequest="45"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        CornerRadius="40"
                        Margin="2,0,0,0" />

                <!-- Titre -->
                <Label Grid.Column="1"
                       Text="Vos Produits"
                       TextColor="White"
                       FontSize="35" 
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <!-- Bouton AddProduct -->
                <Button Grid.Column="2"
                        Text="+"
                        Clicked="OnAddProductClicked"
                        FontSize="40"
                        TextColor="White"
                        BackgroundColor="#58BF7F"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="5" 
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="0, -13, 0, 0" />
            </Grid>
            
            <!-- MiniHeader -->
            <Grid Grid.Row="1" BackgroundColor="White" Padding="0" HeightRequest="32.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       Text="{Binding DisplayedProductsCount, StringFormat='Produits enregistrés : {0}'}"
                       FontSize="14"
                       TextColor="Gray"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" 
                       Margin="5,0,0,0" />

                <Button Grid.Column="1"
                        Text="{Binding SortButtonText}"
                        Clicked="OnSortButtonClicked"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        TextColor="Gray"
                        VerticalOptions="Center"
                        Padding="0"
                        Margin="15,0,5,0" />
            </Grid>
            
            <!-- Product Cards -->
            <RefreshView Grid.Row="2"
                         x:Name= "ProductRefreshView"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}" >
                
                <CollectionView ItemsSource="{Binding Products}"
                                SelectionMode="Single"
                                SelectionChanged="OnProductSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="localModels:ProductInfos"> 
                        <Border Padding="0"
                                Stroke="DarkGray"
                                StrokeThickness="0.1"
                                BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Brush="LightGray" Offset="0,0" Radius="5" Opacity="0.5" />
                            </Border.Shadow>
                            
                            <Grid HeightRequest="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image -->
                                <Border Grid.Column="0"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Margin="10,0,0,0"
                                        Padding="0"                
                                        Background="Transparent"   
                                        StrokeShape="{RoundRectangle CornerRadius='3'}"  
                                        Stroke="Transparent"       
                                        StrokeThickness="0">
                                    <Image Source="{Binding UrlImage}"
                                           Aspect="AspectFill"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Quantité / DLC -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Padding="10,0">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"  MaxLines="2"
                                           TextColor="Black"/>
                                    <Label Text="{Binding Quantity, StringFormat='Quantité: {0}'}"
                                           FontSize="14"
                                           TextColor="Gray"/>
                                    <Label Text="{Binding Dlc, StringFormat='DLC: {0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="DarkGray"/>
                                </VerticalStackLayout>

                                <!-- Pastille pour DLC / jours restants -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding DaysRemaining, Converter={StaticResource dlcColorConverter}}"
                                        HorizontalOptions="End"     
                                        VerticalOptions="Fill"    
                                        WidthRequest="62"  
                                        Padding="0"                 
                                        Margin="0,0,0,0"           
                                        StrokeShape="{RoundRectangle CornerRadius='15,0,15,0'}"
                                        StrokeThickness="0">
                                    <Label Text="{Binding DaysRemainingTextMainPage}"
                                           TextColor="White"
                                           VerticalOptions="Center" 
                                           HorizontalOptions="Center" 
                                           FontSize="{Binding DaysRemainingFontSize}"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
                </RefreshView>
            <Button Grid.Row="2"
                    ImageSource="bin_white.png"
                    Clicked="OnLostProductsClicked"
                    BackgroundColor="#58BF7F"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="20"
                    VerticalOptions="End"
                    HorizontalOptions="Start"
                    Margin="15,0,15,15"
                    Padding="10"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>