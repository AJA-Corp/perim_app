<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Pages.TotpVerificationPage"
             BackgroundColor="#58BF7F">

    <VerticalStackLayout Spacing="20" VerticalOptions="CenterAndExpand">

        <!-- En-tête vert avec le titre -->
        <Grid Padding="20">
            <Label Text="PerimApp"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Sous-titre -->
        <Label Text="Authentification à deux facteurs"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>

        <!-- Instructions -->
        <Label Text="Entrez le code de 6 chiffres de votre application d'authentification"
               FontSize="16"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="20,20,20,20"/>

        <!-- Champ de saisie TOTP -->
        <VerticalStackLayout Padding="20, 20, 20, 20" Spacing="20" VerticalOptions="CenterAndExpand">
            <Grid>
                <Entry Placeholder="000000"
                       TextColor="White"
                       PlaceholderColor="White"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       FontSize="24"
                       HorizontalTextAlignment="Center"
                       Keyboard="Numeric"
                       MaxLength="6"
                       x:Name="TotpCodeEntry"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         VerticalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Boutons -->
        <VerticalStackLayout Padding="20,20,20,20" Spacing="15" VerticalOptions="EndAndExpand">
            <Button Text="Valider"
                    Clicked="OnValidateClicked"
                    BackgroundColor="White"
                    TextColor="#58BF7F"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>

            <Button Text="Retour"
                    Clicked="OnBackClicked"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>