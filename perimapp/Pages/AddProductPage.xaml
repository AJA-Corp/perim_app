<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Pages.AddProductPage"
             xmlns:headers="clr-namespace:perimapp.Headers"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             BackgroundColor="White">
    
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *, Auto">
            <headers:SharedHeader Grid.Row="0" HeaderText="Ajout Produit">
            </headers:SharedHeader>
            
            <ContentView Grid.Row="1" 
                        Padding="10" HorizontalOptions="FillAndExpand"   VerticalOptions="FillAndExpand">
                   
                   <VerticalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                        
                        <Button Text="Scanner le produit" 
                                FontSize="20"
                                BackgroundColor="#58BF7F"
                                TextColor="White"
                                CornerRadius="50"
                                WidthRequest="300"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,10, 0, 0"
                                Padding="0, -3, 0, 0"
                                Clicked="OnScanButtonClicked"/>
                        
                        <Border WidthRequest="180"
                                HeightRequest="180"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,10, 0, 0"
                                Padding="0"                
                                BackgroundColor="LightGray"   
                                StrokeShape="{RoundRectangle CornerRadius='3'}"  
                                Stroke="Transparent"       
                                StrokeThickness="0">
                               <Grid>
                                      <Label Text="Photo du produit"
                                             TextColor="Black"
                                             FontSize="18"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding HasNoImage, Mode=OneWay}"/> 
                                      <Image x:Name="ProductImage"
                                             Source="{Binding }" 
                                             Aspect="AspectFill"     
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding HasImage, Mode=OneWay}" />
                               </Grid>
                        </Border>
                        
                        <Entry x:Name="BarcodeEntry"
                               Placeholder="Entrez le code-barres"
                               PlaceholderColor="#AAAAAA"
                               Keyboard="Numeric"
                               TextColor="#58BF7F"
                               WidthRequest="250"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Completed="BarcodeEntry_OnCompleted"/>

                        <Label x:Name="ProductName"
                               Text="Nom du produit"
                               FontSize="20"
                               TextColor="Black"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" 
                               Margin="0,5, 0, 0"
                               LineBreakMode="TailTruncation" 
                               MaxLines="1"/>
                        
                        <Label Text="DLC"
                               FontSize="20"
                               TextColor="Black"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5, 0, 0"/>
                        
                        <Border x:Name="DlcBorder"
                                Stroke="#58BF7F"
                                StrokeThickness="1"
                                BackgroundColor="Transparent"
                                Padding="8,4"
                                StrokeShape="{RoundRectangle CornerRadius=12}"
                                HorizontalOptions="Center">
                               <DatePicker x:Name="DlcPicker"
                                           Format="dd/MM/yyyy"
                                           MinimumDate="{x:Static sys:DateTime.Today}"
                                           TextColor="#58BF7F"
                                           HorizontalOptions="Center" />
                        </Border>

                        <Label Text="Quantité"
                               FontSize="20"
                               TextColor="Black"
                               HorizontalOptions="Center"
                               Margin="0,10,0,5"/>

                        <Grid ColumnDefinitions="Auto, Auto, Auto"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              ColumnSpacing="8">
                            
                              <Border Grid.Column="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Stroke="Black"
                                    StrokeThickness="1"
                                    StrokeShape="{RoundRectangle CornerRadius='5'}"
                                    BackgroundColor="White"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center">
                                  
                                    <Button Text="-"
                                          FontSize="25"
                                          TextColor="Black"
                                          BackgroundColor="Transparent"
                                          CornerRadius="0"
                                          Padding="0"
                                          VerticalOptions="FillAndExpand"
                                          HorizontalOptions="FillAndExpand"
                                          Clicked="OnDecrementQuantityClicked"/>
                              </Border>
                            
                              <Border Grid.Column="1"
                                      WidthRequest="60" 
                                      HeightRequest="50"
                                      Stroke="Black"
                                      StrokeThickness="1"
                                      StrokeShape="{RoundRectangle CornerRadius='5'}"
                                      BackgroundColor="White" 
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center">
                                      <Entry x:Name="QuantityEntry"
                                            Text="1"
                                            FontSize="25"
                                            TextColor="Black"
                                            BackgroundColor="White" Keyboard="Numeric"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            Placeholder="1"
                                            ClearButtonVisibility="Never"
                                            MaxLength="2" 
                                            Unfocused="QuantityEntry_Unfocused"/>
                              </Border>

                              <Border Grid.Column="2"
                                     WidthRequest="50"
                                     HeightRequest="50"
                                     Stroke="Black"
                                     StrokeThickness="1"
                                     StrokeShape="{RoundRectangle CornerRadius='5'}"
                                     BackgroundColor="White"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                                     
                                     <Button Text="+"
                                             FontSize="25"
                                             TextColor="Black"
                                             BackgroundColor="Transparent"
                                             CornerRadius="0"
                                             Padding="0"
                                             VerticalOptions="FillAndExpand"
                                             HorizontalOptions="FillAndExpand"
                                             Clicked="OnIncrementQuantityClicked" />
                              </Border>
                        </Grid>

                    <ContentView VerticalOptions="FillAndExpand" /> 
                 </VerticalStackLayout>
            </ContentView>
               <Grid Grid.Row="2"
                     HeightRequest="65"
                     BackgroundColor="#58BF7F"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="End">
                      <Button Text="Valider"
                              BackgroundColor="White"
                              TextColor="Black"
                              FontAttributes="Bold"
                              CornerRadius="30"
                              FontSize="20"
                              Padding="0,5"
                              Margin="0,10"
                              WidthRequest="300"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="Center"
                              Clicked="OnValidateClicked"/>
               </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>