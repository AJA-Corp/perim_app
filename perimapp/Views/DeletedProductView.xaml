<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Views.DeletedProductView"
             xmlns:localModels="clr-namespace:perimapp.Models"
             xmlns:localConverters="clr-namespace:perimapp.Converters"
             xmlns:components="clr-namespace:perimapp.Components" 
             BackgroundColor="White">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <!-- Bande verte tout en haut -->
            <BoxView Grid.Row="0" BackgroundColor="#58BF7F" HeightRequest="15" HorizontalOptions="Fill" />

            <!-- En-tête avec bouton retour, titre et bouton "Tout supprimer" -->
            <Grid Grid.Row="1" Padding="15,12,15,12" BackgroundColor="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <ImageButton Grid.Column="0"
                             Source="arrow_back.png"
                             Command="{Binding GoBackCommand}"
                             WidthRequest="38"
                             HeightRequest="38"
                             CornerRadius="19"
                             BackgroundColor="#F5F5F5"
                             Padding="9"
                             VerticalOptions="Center"
                             Margin="0,0,10,0" />

                <!-- Titre -->
                <Label Grid.Column="1"
                       Text="Produits Supprimés"
                       FontSize="22"
                       FontFamily="InterBold"
                       TextColor="Black"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />

                <!-- Bouton Supprimer tout -->
                <Button Grid.Column="2"
                        Text="Tout supprimer"
                        Command="{Binding DeleteAllCommand}"
                        TextColor="#FF5252"
                        BackgroundColor="#FFEBEE"
                        CornerRadius="16"
                        FontSize="12"
                        FontFamily="InterMedium"
                        HeightRequest="34"
                        Padding="10,0"
                        VerticalOptions="Center" />
            </Grid>

            <CollectionView Grid.Row="2" 
                            ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            Margin="10">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="Aucun produit dans la corbeille"
                               TextColor="Gray"
                               FontSize="16"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="localModels:ProductInfos">
                        <Border Padding="0"
                                Margin="0,0,0,10"
                                Stroke="DarkGray"
                                StrokeThickness="0.1"
                                BackgroundColor="White"
                                StrokeShape="{RoundRectangle CornerRadius='5'}">
                            <Border.Shadow>
                                <Shadow Brush="LightGray" Offset="0,0" Radius="5" Opacity="0.5" />
                            </Border.Shadow>

                            <Grid HeightRequest="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" WidthRequest="80" HeightRequest="80"
                                        HorizontalOptions="Center" VerticalOptions="Center" Margin="10,0,0,0"
                                        StrokeShape="{RoundRectangle CornerRadius='3'}" StrokeThickness="0">
                                    <Image Source="{Binding UrlImage}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="10,0">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" TextColor="Black"/>
                                    <Label Text="{Binding Quantity, StringFormat='Quantité: {0}'}" FontSize="14" TextColor="Gray"/>
                                    <Label Text="{Binding Dlc, StringFormat='DLC: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="DarkGray"/>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" 
                                                       Spacing="10" 
                                                       VerticalOptions="Center" 
                                                       Margin="0,0,15,0">

                                    <ImageButton Source="arrows.png"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RestoreCommand}"
                                                 CommandParameter="{Binding .}"
                                                 BackgroundColor="#58BF7F"
                                                 WidthRequest="50"
                                                 HeightRequest="50"
                                                 CornerRadius="25"
                                                 Padding="3"
                                                 Aspect="AspectFit"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Navbar du bas -->
            <components:BottomNavBar Grid.Row="3" ActiveTab="" />
        </Grid>
    </ContentPage.Content>
</ContentPage>