<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:perimapp.Components"
             xmlns:viewmodels="clr-namespace:perimapp.ViewModels"
             x:DataType="viewmodels:ProfileViewModel"
             x:Class="perimapp.Views.ProfileView"
             BackgroundColor="#FFF">

    <ContentPage.Resources>
        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterBold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="TextColor" Value="DarkSlateGray"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="CardContentStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterMedium"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="CardMiniContentStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterMedium"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Bande verte tout en haut -->
        <BoxView Grid.Row="0" BackgroundColor="#58BF7F" HeightRequest="15" HorizontalOptions="Fill" />

        <!-- En-tête -->
        <Grid Grid.Row="1" Padding="20,15,20,10" BackgroundColor="White">
            <Label Text="Profil"
                   FontSize="26"
                   FontFamily="InterBold"
                   TextColor="Black"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Contenu du profil -->
        <ScrollView Grid.Row="2" VerticalOptions="Fill">
            <VerticalStackLayout Spacing="15" Padding="15" VerticalOptions="Center">

                <Border WidthRequest="130" HeightRequest="130"
                        StrokeShape="RoundRectangle 65"
                        Stroke="Transparent"
                        BackgroundColor="Black"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0,10,0,0">
                    <Image Source="profile_placeholder.png"
                           Aspect="AspectFill"/>
                </Border>

                <Label x:Name="NameLabel"
                       Text="{Binding UserName}"
                       Style="{StaticResource CardTitleStyle}"/>

                <VerticalStackLayout Spacing="5"
                                     Padding="0,10"
                                     HorizontalOptions="Fill">
                    <Label Text="Quantité de produits enregistrés :"
                           Style="{StaticResource CardContentStyle}"/>
                    <Label Text="{Binding RegisteredProductsCount}"
                           Style="{StaticResource CardMiniContentStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5"
                                     Padding="0,10"
                                     HorizontalOptions="Fill">
                    <Label Text="Produits perdus :"
                           Style="{StaticResource CardContentStyle}"/>
                    <Label Text="{Binding LostProductsCount}"
                           Style="{StaticResource CardMiniContentStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5"
                                     Padding="0,10"
                                     HorizontalOptions="Fill">
                    <Label Text="Code foyer :" Style="{StaticResource CardContentStyle}"/>
                    <Label x:Name="FoyerCodeLabel"
                           Text="{Binding FamilyCode}"
                           Style="{StaticResource CardMiniContentStyle}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Navbar du bas -->
        <components:BottomNavBar Grid.Row="3" ActiveTab="Profile" />
    </Grid>
</ContentPage>