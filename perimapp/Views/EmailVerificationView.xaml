<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Views.EmailVerificationView"
             BackgroundColor="#58BF7F">

    <VerticalStackLayout Spacing="20" VerticalOptions="CenterAndExpand">

        <Grid Padding="20">
            <Label Text="Perim'App"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <Label Text="Vérification email"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>

        <Label x:Name="InfoLabel"
               Text="{Binding InfoText}"
               FontSize="16"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="20,0,20,20"/>

        <VerticalStackLayout Padding="20, 20, 20, 20" Spacing="20" VerticalOptions="CenterAndExpand">

            <Grid>
                <Entry Placeholder="Code de vérification (6 chiffres)"
                       TextColor="White"
                       PlaceholderColor="White"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       FontSize="20"
                       Keyboard="Numeric"
                       MaxLength="6"
                       Text="{Binding VerificationCode, Mode=TwoWay}"
                       x:Name="VerificationCodeEntry"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         VerticalOptions="End"/>
            </Grid>

            <Label x:Name="TimerLabel"
                   Text="{Binding TimerText}"
                   FontSize="14"
                   TextColor="{Binding TimerTextColor}"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

        <VerticalStackLayout Padding="20,20,20,20" Spacing="15" VerticalOptions="EndAndExpand">
            <Button Text="Vérifier"
                    Command="{Binding VerifyCommand}"
                    BackgroundColor="White"
                    TextColor="#58BF7F"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>

            <Button Text="Renvoyer le code"
                    Command="{Binding ResendCodeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"
                    BorderColor="White"
                    BorderWidth="2"/>

            <Button Text="Retour"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>