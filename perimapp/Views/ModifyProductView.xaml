<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Views.ModifyProductView"
             xmlns:localModels="clr-namespace:perimapp.Models"
             xmlns:localConverters="clr-namespace:perimapp.Converters"  
             xmlns:headers="clr-namespace:perimapp.Headers" 
             xmlns:views="clr-namespace:perimapp.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             BackgroundColor="White">

    <ContentPage.Resources>
        <localConverters:DlcColorConverter x:Key="dlcColorConverter"/>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *, Auto">
            <headers:SharedHeader Grid.Row="0" HeaderText="Modifier"
                                  ProductUniqueId="{Binding ProductUniqueId, 
                                  Source={RelativeSource 
                                  AncestorType={x:Type views:DetailsView}}}">
            </headers:SharedHeader>

            <ScrollView Grid.Row="1" 
                        Padding="10" 
                        HorizontalOptions="Fill"   
                        VerticalOptions="Fill">
                <VerticalStackLayout Spacing="10"
                                      HorizontalOptions="Fill">
                    <Border WidthRequest="150"
                            HeightRequest="150"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="0,20,0,10"
                            Padding="0"                
                            Background="Transparent"   
                            StrokeShape="{RoundRectangle CornerRadius='3'}"  
                            Stroke="Transparent"       
                            StrokeThickness="0">
                        <Image Source="{Binding CurrentProduct.UrlImage}" 
                                      Aspect="AspectFill"     
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"/>
                    </Border>

                    <Entry x:Name="ProductNameEntry"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" Margin="0,0,0,10"
                            Placeholder="Nom du produit"
                            Text="{Binding CurrentCustomName, Mode=TwoWay}"
                            TextChanged="ProductNameEntry_TextChanged"/>

                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="DLC: "
                                FontSize="15"
                                TextColor="Gray"
                                VerticalOptions="Center"/>

                        <Border x:Name="ProductDlcEntry"
                                 BackgroundColor="Transparent"
                                 Padding="8,4"
                                 StrokeShape="{RoundRectangle CornerRadius=12}"
                                 HorizontalOptions="Center">
                            <DatePicker x:Name="DlcPicker"
                                         Date="{Binding CurrentProduct.Dlc, Mode=TwoWay}"
                                         Format="dd/MM/yyyy"
                                         TextColor="Black"
                                         HorizontalOptions="Center"
                                         />
                        </Border>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto, Auto, Auto"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ColumnSpacing="8">

                        <Border Grid.Column="0"
                                   WidthRequest="50"
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}"
                                   BackgroundColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">

                            <Button Text="-"
                                           FontSize="25"
                                           TextColor="Black"
                                           BackgroundColor="Transparent"
                                           CornerRadius="0"
                                           Padding="0"
                                           VerticalOptions="Fill"
                                           HorizontalOptions="Fill"
                                           Command="{Binding DecrementQuantityCommand}"/>
                        </Border>

                        <Border Grid.Column="1"
                                   WidthRequest="60" 
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}" 
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                            <Entry x:Name="QuantityEntry"
                                          Text="{Binding CurrentQuantity, Mode=TwoWay}"  
                                          FontSize="25"
                                          TextColor="Black"
                                          VerticalTextAlignment="Center"
                                          HorizontalTextAlignment="Center"
                                          VerticalOptions="Center"
                                          BackgroundColor="White"
                                          Keyboard="Numeric"
                                          ClearButtonVisibility="Never"
                                          MaxLength="2"/>
                        </Border>

                        <Border Grid.Column="2"
                                   WidthRequest="50"
                                   HeightRequest="50"
                                   Stroke="Black"
                                   StrokeThickness="1"
                                   StrokeShape="{RoundRectangle CornerRadius='5'}"
                                   BackgroundColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                            <Button Text="+"
                                           FontSize="25"
                                           TextColor="Black"
                                           BackgroundColor="Transparent"
                                           CornerRadius="0"
                                           Padding="0"
                                           VerticalOptions="Fill"
                                           HorizontalOptions="Fill"
                                           Command="{Binding IncrementQuantityCommand}" />
                        </Border>
                    </Grid>

                    <Border BackgroundColor="LightGray"
                            Padding="15"
                            Margin="0,10,0,10"
                            Stroke="Transparent"
                            HorizontalOptions="Fill">
                        <Label Text="{Binding CurrentProduct.Category, StringFormat='Catégories : {0}'}"
                               FontSize="15"
                               TextColor="Black"
                               HorizontalOptions="Fill"   
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation"
                               MaxLines="4"/>
                    </Border>

                    <ContentView VerticalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2"
                  HeightRequest="65"
                  BackgroundColor="#58BF7F"
                  HorizontalOptions="Fill"
                  VerticalOptions="End">
                <Button Text="Enregistrer"
                          BackgroundColor="White"
                          TextColor="Black"
                          FontAttributes="Bold"
                          CornerRadius="30"
                          FontSize="20"
                          Padding="0,5"
                          Margin="0,10"
                          WidthRequest="300"
                          HorizontalOptions="Fill"
                          VerticalOptions="Center"
                          Command="{Binding SaveProductCommand}"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>