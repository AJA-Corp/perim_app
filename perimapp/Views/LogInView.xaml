<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:perimapp.Controls"
             x:Class="perimapp.Views.LogInView"
             BackgroundColor="#58BF7F">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20, 60, 20, 40">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Perim'App"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Label Text="Se connecter"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center" Margin="10, 0, 10, 0">

            <Grid>
                <controls:WhiteCursorEntry Placeholder="Adresse mail"
                                           TextColor="White"
                                           FontFamily="InterMedium"
                                           PlaceholderColor="White"
                                           BackgroundColor="Transparent"
                                           HeightRequest="50"
                                           FontSize="20"
                                           Text="{Binding EmailText, Mode=TwoWay}"
                                           x:Name="EmailEntry"/>
                <BoxView HeightRequest="1" BackgroundColor="White" VerticalOptions="End"/>
            </Grid>

            <Grid ColumnDefinitions="*, Auto">
                <controls:WhiteCursorEntry Placeholder="Mot de passe"
                               IsPassword="True" TextColor="White"
                               FontFamily="InterMedium"
                               PlaceholderColor="White"
                               BackgroundColor="Transparent"
                               HeightRequest="50"
                               FontSize="20"
                               Text="{Binding PasswordText, Mode=TwoWay}"
                               x:Name="PasswordEntry"
                               Grid.Column="0"/>

                <ImageButton x:Name="PasswordIcon"
                 Source="visibility_off_white.png" 
                 Clicked="OnTogglePasswordVisibilityClicked"
                 BackgroundColor="Transparent"
                 HeightRequest="25"
                 WidthRequest="25"
                 Margin="0,0,5,0"
                 VerticalOptions="Center"
                 Grid.Column="1"/>

                <BoxView HeightRequest="1" BackgroundColor="White" VerticalOptions="End" Grid.ColumnSpan="2"/>
            </Grid>

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Button Text="Se connecter"
                    Command="{Binding NextLogInCommand}"
                    BackgroundColor="White"
                    TextColor="#58BF7F"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>

            <Button Text="Retour"
                    Command="{Binding BackLogInCommand}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>