<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Views.LogInView"
             BackgroundColor="#58BF7F">

    <VerticalStackLayout Spacing="20" VerticalOptions="CenterAndExpand">

        <Grid Padding="20">
            <Label Text="Perim'App"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <Label Text="Se connecter"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>

        <VerticalStackLayout Padding="20, 20, 20, 20" Spacing="20" VerticalOptions="CenterAndExpand">

            <Grid>
                <Entry Placeholder="Adresse mail"
                       TextColor="White"
                       PlaceholderColor="White"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       FontSize="20"
                       Text="{Binding EmailText, Mode=TwoWay}"
                       x:Name="EmailEntry"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         VerticalOptions="End"/>
            </Grid>

            <Grid>
                <Entry Placeholder="Mot de passe"
                       IsPassword="True"
                       TextColor="White"
                       PlaceholderColor="White"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       FontSize="20"
                       Text="{Binding PasswordText, Mode=TwoWay}"
                       x:Name="PasswordEntry"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         VerticalOptions="End"/>
            </Grid>

            <Label Text="Ou"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,0,0,0"/>

            <Grid>
                <Entry Placeholder="Code foyer ?"
                       TextColor="White"
                       PlaceholderColor="White"
                       BackgroundColor="Transparent"
                       Keyboard="Numeric"
                       HeightRequest="50"
                       FontSize="20"
                       Text="{Binding HomeCodeText, Mode=TwoWay}"
                       x:Name="CodeFoyerEntry"/>
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         VerticalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Padding="20,20,20,20" Spacing="15" VerticalOptions="EndAndExpand">
            <Button Text="Suivant"
                    Command="{Binding NextLogInCommand}"
                    BackgroundColor="White"
                    TextColor="#58BF7F"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>

            <Button Text="Retour"
                    Command="{Binding BackLogInCommand}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="50"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
