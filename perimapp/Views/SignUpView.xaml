<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="perimapp.Views.SignUpView"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#58BF7F" Padding="20">
            <Label Text="Perim'App"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1" VerticalOptions="Center" Padding="25,0">
            <VerticalStackLayout Spacing="15">

                <Label Text="Inscription"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       Margin="0,0,0,40"/>

                <Grid>
                    <Entry Placeholder="Email"
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           FontSize="18"
                           Text="{Binding EmailText, Mode=TwoWay}"
                           x:Name="EmailEntry"/>
                    <BoxView HeightRequest="1" BackgroundColor="Black" VerticalOptions="End"/>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Placeholder="Mot de passe"
                               IsPassword="True"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="Transparent"
                               HeightRequest="45"
                               FontSize="18"
                               Text="{Binding PasswordText, Mode=TwoWay}"
                               x:Name="PasswordEntry"
                               Grid.Column="0"/>

                        <ImageButton x:Name="PasswordIcon"
                                     Source="visibility_off_green.png"
                                     Clicked="OnTogglePasswordVisibilityClicked"
                                     BackgroundColor="Transparent"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     Margin="0,0,5,0"
                                     VerticalOptions="Center"
                                     Grid.Column="1"/>

                        <BoxView HeightRequest="1" BackgroundColor="Black" VerticalOptions="End" Grid.ColumnSpan="2"/>
                    </Grid>
                    <Label Text="Minimum 10 caractères"
                           FontSize="11"
                           TextColor="Gray"
                           Margin="5,0,0,0" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, Auto">
                    <Entry Placeholder="Confirmer mot de passe"
                           IsPassword="True"
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           FontSize="18"
                           Text="{Binding ConfirmPasswordText, Mode=TwoWay}"
                           x:Name="ConfirmPasswordEntry"
                           Grid.Column="0"/>

                    <ImageButton x:Name="ConfirmPasswordIcon"
                                 Source="visibility_off_green.png"
                                 Clicked="OnToggleConfirmPasswordVisibilityClicked"
                                 BackgroundColor="Transparent"
                                 HeightRequest="22"
                                 WidthRequest="22"
                                 Margin="0,0,5,0"
                                 VerticalOptions="Center"
                                 Grid.Column="1"/>

                    <BoxView HeightRequest="1" BackgroundColor="Black" VerticalOptions="End" Grid.ColumnSpan="2"/>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Grid>
                        <Entry Placeholder="Code foyer (Optionnel)"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="Transparent"
                               HeightRequest="45"
                               FontSize="18"
                               Text="{Binding HomeCodeText, Mode=TwoWay}"
                               x:Name="HomeCodeEntry"/>
                        <BoxView HeightRequest="1" BackgroundColor="Black" VerticalOptions="End"/>
                    </Grid>
                    <Label Text="Si vide, un code sera généré pour votre foyer"
                           FontSize="11"
                           TextColor="Gray"
                           Margin="5,0,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="2" 
                             Padding="20,0,20,30" 
                             Spacing="10">

            <Button Text="Suivant"
                    Command="{Binding NextSignUpCommand}"
                    BackgroundColor="#58BF7F"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>

            <Button Text="Retour"
                    Command="{Binding BackSignUpCommand}"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="250"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>